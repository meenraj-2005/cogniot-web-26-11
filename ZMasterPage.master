                 aria-label="Primary navigation">


                <!-- HOME -->
                <a class="nav-link"
                   href="<%= ResolveUrl("~/Default.aspx") %>">

                    Home

                </a>


                <!-- ABOUT US DROPDOWN -->
                <div class="nav-dropdown">

                    <button type="button"
                            class="nav-dropdown-toggle"
                            aria-haspopup="true"
                            aria-expanded="false">

                        About Us <span class="dropdown-arrow">⌄</span>

                    </button>

                    <div class="nav-panel">

                        <a href="<%= ResolveUrl("~/web/our_story.aspx") %>">
                            Our Story
                        </a>

                        <a href="<%= ResolveUrl("~/web/MissionVision.aspx") %>">
                            Mission &amp; Vision
                        </a>

                        

                        <a href="<%= ResolveUrl("~/web/RecognitionMilestones.aspx") %>">
                             Recognitions &amp Milestones
                        </a>

                        <a href="<%= ResolveUrl("~/web/OurClientsPartners.aspx") %>">
                            Our Clients &amp Partners

                        </a>

                    </div>

                </div>


                <!-- Technologies DROPDOWN -->
                <div class="nav-dropdown">

                    <button type="button"
                            class="nav-dropdown-toggle"
                            aria-haspopup="true"
                            aria-expanded="false">

                        Technologies <span class="dropdown-arrow">⌄</span>

