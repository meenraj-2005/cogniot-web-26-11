                </a>

                <a href="<%= ResolveUrl("~/web/AISaaS.aspx") %>">
                    Services
                </a>

                <a href="<%= ResolveUrl("~/web/govtechsolutions.aspx") %>">
                    Industries
                </a>

                <a href="<%= ResolveUrl("~/web/projectPortfolio.aspx") %>">
                    Portfolio
                </a>

            </div>


            <!-- WORK WITH US -->
            <div class="footer-link-group">

                <h2>Work with us</h2>

                <a href="<%= ResolveUrl("~/web/Internship.aspx") %>">
                    Internship
                </a>

                <a href="<%= ResolveUrl("~/web/currentopenings.aspx") %>">
                    Job opportunities
                </a>

                <a href="<%= ResolveUrl("~/web/Contact.aspx") %>">
                    Start a conversation
                </a>

                <a href="mailto:cogniottech@gmail.com">
                    cogniottech@gmail.com
                </a>

                <a href="mailto:ceo@cogniot.co.in">
                     ceo@cogniot.co.in
                </a>

            </div>


        </div>


        <!-- FOOTER BOTTOM -->
        <div class="container footer-bottom">

            <span>
               <asp:Literal ID="litYear" runat="server" />
                COGNIOT TECHNOLOGY PRIVATE LIMITED All Rights Reserved
            </span>

            <span>
                Next Generation Technology
            </span>

